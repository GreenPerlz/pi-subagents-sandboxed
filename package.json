{
  "name": "pi-subagents-sandboxed",
  "version": "0.27.0-sandbox.0",
  "description": "Pi extension for delegating tasks to subagents with chains, parallel execution, TUI clarification, and optional sandboxing",
  "author": "Nico Bailon",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreenPerlz/pi-subagents-sandboxed.git"
  },
  "homepage": "https://github.com/GreenPerlz/pi-subagents-sandboxed#readme",
  "bugs": {
    "url": "https://github.com/GreenPerlz/pi-subagents-sandboxed/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "bin": {
    "pi-subagents-sandboxed": "install.mjs"
  },
  "files": [
    "src/**/*.ts",
    "*.mjs",
    "agents/",
    "docs/",
    "skills/**/*",
    "prompts/**/*",
    "scripts/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check:pi-version": "node scripts/check-pi-version.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=1 test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test --test-concurrency=1 test/integration/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "pi": {
    "extensions": [
      "./src/extension/pi-subagents-sandboxed.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.4",
    "jiti": "^2.7.0",
    "pi-subagent-runtime": "npm:@earendil-works/pi-coding-agent@0.84.3",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4"
  }
}
